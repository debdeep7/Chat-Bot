# Copy this file to .env and fill it in. .env is git-ignored; never commit a real key.

# Free key from https://aistudio.google.com/ -> "Get API key"
GEMINI_API_KEY=
# Which Gemini model to call. gemini-2.5-* is closed to new projects; this one is fast and cheap.
# A stronger (slower) option is gemini-3.8-flash. Your free limits per model: https://aistudio.google.com/rate-limit
GEMINI_MODEL=gemini-3.5-flash-lite

# Safety rails for the free tier (defaults are conservative; raise them if your limits allow)
# LLM_PER_MINUTE=8      model calls we allow ourselves per minute
# LLM_TIMEOUT=8         seconds before one model call is abandoned
# TICK_BUDGET=8         seconds a tick may wait for the model before using templates
# USE_LLM=1             set to 0 to run on templates only (no model calls at all)

# Shown publicly on GET /v1/metadata
TEAM_NAME=
TEAM_MEMBERS=
CONTACT_EMAIL=
